{
  "name": "coedit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "bootstrap": "npm exec --yes --package=pnpm@11.24.0 -- pnpm install --frozen-lockfile",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:deps": "depcruise src --config dependency-cruiser.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "typedoc --options typedoc.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run lint:deps && npm run docs:check && npm run test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "prettier": "3.9.6",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  }
}
