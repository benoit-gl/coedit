+import * as A from "@automerge/automerge";
+import { describe, expect, it } from "vitest";
+import { parseBlockId } from "../../../src/domain/index.js";
+import { AutomergeImmutableRunDocument } from "./nativeDocument.js";
+import { AutomergeRecordPrimitive } from "./nativeRecordStore.js";
+import { commitRecordV1 } from "./record.js";
+
+const id = "c1000000-0000-4000-8000-000000000001";
+interface State { records: Record<string, unknown>; layout: Record<string, boolean> }
+describe("hex2 scratch layout rejects incompatible namespace encodings", () => {
+  it.each(["c", "C1", "c11", "gg"])("rejects prefix %s", (invalid) => {
+    const doc = AutomergeImmutableRunDocument.create(parseBlockId(id));
+    let raw = A.load<State>(doc.encode());
+    const key = Object.keys(raw.records)[0]!;
+    const subtree = A.toJS(raw).records[key];
+    raw = A.change(raw, (draft) => {
+      delete draft.records[key];
+      draft.records[invalid] = subtree;
+    });
+    expect(() => AutomergeImmutableRunDocument.load(A.save(raw))).toThrow(/prefix key/i);
+  });
+  it("requires exact UUID path even for valid two-digit prefixes", () => {
+    const doc = AutomergeImmutableRunDocument.create(parseBlockId(id));
+    let raw = A.load<State>(doc.encode());
+    const key = Object.keys(raw.records)[0]!;
+    const subtree = A.toJS(raw).records[key];
+    raw = A.change(raw, (draft) => {
+      delete draft.records[key];
+      draft.records[key === "00" ? "01" : "00"] = subtree;
+    });
+    expect(() => AutomergeImmutableRunDocument.load(A.save(raw))).toThrow(/UUID.*path/i);
+  });
+  it("rejects the original full-document layout explicitly", () => {
+    const doc = AutomergeImmutableRunDocument.create(parseBlockId(id));
+    const raw = A.change(A.load<State>(doc.encode()), (draft) => {
+      draft.layout = { "step3-immutable-runs-v1": true };
+    });
+    expect(() => AutomergeImmutableRunDocument.load(A.save(raw))).toThrow(/layout/i);
+  });
+  it("rejects the original primitive layout explicitly", () => {
+    const doc = AutomergeRecordPrimitive.create();
+    doc.append([commitRecordV1(["coedit-step3-record",1,id,"live",["block",id],null,null,["actor","effect"],id,["payload",0,1],[]])]);
+    const raw = A.change(A.load<{layout:string}>(doc.encode()), (draft) => {
+      draft.layout = "step3-immutable-runs-native-primitive-v1";
+    });
+    expect(() => AutomergeRecordPrimitive.load(A.save(raw))).toThrow(/layout/i);
+  });
+});
